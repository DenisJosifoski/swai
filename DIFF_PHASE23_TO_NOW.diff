-        if self.running_models.len() >= max {
-            return Err(ProcessError::AnotherModelRunning);
-        }
-
-        // Find the model config
-        let model_config = self
-            .config
-            .models
-            .iter()
-            .find(|m| m.id == id)
-            .ok_or_else(|| ProcessError::NotRunning(id.to_string()))?;
-
-        // Check port — zombie port handling

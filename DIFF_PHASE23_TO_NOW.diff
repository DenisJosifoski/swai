-                .config
-                .models
-                .iter()
-                .find(|m| m.id == running.id)
-                .map(|m| m.port)
-                .ok_or_else(|| ProcessError::NotRunning(running.id.clone()))?;
-            running.guard.terminate(fast_shutdown)?;
